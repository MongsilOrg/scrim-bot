# ============================================================
# Discord 설정 (필수)
# ============================================================

# Discord 봇 토큰 (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Discord 서버(길드) ID
GUILD_ID=

# 관리자 역할 ID (쉼표로 구분)
ADMIN_ROLE_IDS=

# ============================================================
# 채널 ID 설정 (필수)
# ============================================================

# 스크림 공지 채널
NOTICE_CHANNEL_ID=

# 전적 백업 채널
BACKUP_ANALYSIS_CHANNEL_ID=

# 조별 채널 ID (형식: A:채널ID,B:채널ID,...)
GROUP_CHANNEL_IDS=A:,B:,C:,D:,E:,F:

# ============================================================
# 채널/사용자 ID 설정 (선택)
# ============================================================

# 스크림 대시보드 채널
SCRIM_CHANNEL_ID=

# 운영 로그 채널
LOG_CHANNEL_ID=

# 주간 편성 일정 대시보드 채널
SCHEDULE_CHANNEL_ID=

# 테스트 계정 문의 안내에 표시할 사용자 ID
TEST_ACCOUNT_CONTACT_ID=

# ============================================================
# BSER API 설정 (필수)
# ============================================================

# 이터널 리턴 Open API 키
# https://developer.eternalreturn.io/ 에서 발급
BSER_API_KEY=

# ============================================================
# Google Sheets 설정 (필수)
# ============================================================

# 서비스 계정 인증 파일 경로
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google_sheets_credentials.json

# 메인 스프레드시트 ID (시드팀, 테스트 계정, 패널티 공통)
GOOGLE_SHEETS_MAIN_SPREADSHEET_ID=

# ============================================================
# Notion 설정 (선택)
# ============================================================

# 서버 상태 조회용 Notion 토큰
NOTION_TOKEN=

# 일정 조회용 Notion 데이터베이스 ID
NOTION_DATABASE_ID=

# ============================================================
# 데이터 파일 경로 (선택)
# ============================================================

# 팀 데이터 백업 파일 경로
TEAM_BACKUP_PATH=data/teams_backup.json

# 마스터즈 진행일 처리 상태 파일 경로
MASTERS_STATE_PATH=data/masters_state.json

# ============================================================
# 로깅 설정 (선택)
# ============================================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 로그 파일 경로
LOG_FILE=scrimbot.log

# ============================================================
# UI 설정 (선택)
# ============================================================

# 임베드 푸터 텍스트
EMBED_FOOTER_TEXT=ER Scrim | Powered by Mongsil

# 공지사항 메시지 (마크다운 지원)
ANNOUNCEMENT_MESSAGE=

# 조별 카테고리 이름 패턴 ({letter}가 조 문자로 대체됨)
GROUP_CATEGORY_PATTERN=Group {letter}

# ============================================================
# Sentry 설정 (선택)
# ============================================================

# Sentry DSN (에러 추적)
SENTRY_DSN=
